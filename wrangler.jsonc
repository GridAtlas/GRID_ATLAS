{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "grid-atlas-cloud-local",
  "main": "cloud/worker.js",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "WEB_ORIGINS": "http://localhost:5177,http://127.0.0.1:5177,http://localhost:4173,http://127.0.0.1:4173",
    "AUTH_JWKS_URL": "",
    "AUTH_ISSUER": "",
    "AUTH_AUDIENCE": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grid-atlas-cloud-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "cloud/migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  },
  "env": {
    "staging": {
      "name": "grid-atlas-cloud-staging",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "WEB_ORIGINS": "https://gridatlas.github.io",
        "AUTH_JWKS_URL": "",
        "AUTH_ISSUER": "",
        "AUTH_AUDIENCE": "",
        "PERSONAL_OWNER_ID": "personal-beta",
        "FRIEND_OWNER_ID": "friend-beta"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "grid-atlas-cloud-staging",
          "database_id": "dcf00f6a-8380-49e9-9589-009a0198914a",
          "migrations_dir": "cloud/migrations"
        }
      ],
      "secrets": {
        "required": ["PERSONAL_ACCESS_CODE", "FRIEND_ACCESS_CODE"]
      }
    }
  }
}
