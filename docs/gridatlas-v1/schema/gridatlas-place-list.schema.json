{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gridatlas.github.io/spec/v1/gridatlas-place-list.schema.json",
  "$comment": "SPDX-License-Identifier: CC0-1.0",
  "title": "GRID ATLAS place-list document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "type",
    "schemaVersion",
    "id",
    "name",
    "places"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "type": {
      "const": "place-list"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "attribution": {
      "$ref": "#/$defs/attribution"
    },
    "createdAt": {
      "$ref": "#/$defs/dateTime"
    },
    "updatedAt": {
      "$ref": "#/$defs/dateTime"
    },
    "media": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mediaReference"
      }
    },
    "places": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/place"
      }
    },
    "extensions": {
      "$ref": "#/$defs/extensions"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,199}$"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "license": {
          "type": "string",
          "maxLength": 200
        }
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude",
        "longitude"
      ],
      "properties": {
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "mediaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resourceId",
        "role"
      ],
      "properties": {
        "resourceId": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "caption": {
          "type": "string",
          "maxLength": 1000
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)+$"
      },
      "additionalProperties": true
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "position"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "position": {
          "$ref": "#/$defs/position"
        },
        "note": {
          "type": "string",
          "maxLength": 10000
        },
        "createdAt": {
          "$ref": "#/$defs/dateTime"
        },
        "updatedAt": {
          "$ref": "#/$defs/dateTime"
        },
        "media": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/mediaReference"
          }
        },
        "extensions": {
          "$ref": "#/$defs/extensions"
        }
      }
    }
  }
}
