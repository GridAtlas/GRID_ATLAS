{
  "name": "GRID ATLAS",
  "short_name": "GRID",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#020806",
  "theme_color": "#020806",
  "icons": [
    {
      "src": "assets/icon-grid-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icon-grid-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "assets/icon-grid.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "share_title",
      "text": "share_text",
      "url": "share_url"
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/vnd.gridatlas+zip": [
          ".gridatlas"
        ]
      }
    }
  ]
}